# Copy this file to ".env" and adjust. Used by docker-compose.yml.

# Password needed to edit. Leave empty only if nobody else can reach the app.
ADMIN_PASSWORD=

# 127.0.0.1 = only this computer. 0.0.0.0 = everybody who can reach this machine.
BIND_ADDRESS=127.0.0.1

# Port on this machine.
PORT=8080

# true = nobody can edit at all, not even with the password.
READ_ONLY=false

# true when the app sits behind a reverse proxy that provides HTTPS (nginx, Caddy, Traefik).
TRUST_PROXY=false
