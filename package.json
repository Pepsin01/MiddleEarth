{
  "name": "middle-earth-chronicle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive story map of Middle-earth: the events and journeys of The Rings of Power, episode by episode.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch-path=server --watch-path=shared server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run data:check",
    "media:fetch": "node scripts/fetch-media.ts",
    "map:tiles": "node scripts/make-tiles.ts",
    "data:check": "node scripts/check-data.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "multer": "^2.5.0",
    "node-html-parser": "^9.0.7",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  }
}
